        try:
            user = query.message.reply_to_message.from_user.id
        except Exception:
            user = query.from_user.id
        if int(user) != 0 and query.from_user.id != int(user):
            try:
                return await query.answer(script.NT_ALRT_TXT, show_alert=True)
            except Exception:
                return
        try:
            await query.answer("ᴛʜᴀɴᴋs ꜰᴏʀ ᴄʟᴏsᴇ 🙈")
        except Exception:
            pass
        try:
            await query.message.delete()
        except Exception:
            pass
        try:
            await query.message.reply_to_message.delete()
        except Exception:
            pass

    elif query.data == "pages":
        try:
            await query.answer("ᴛʜɪs ɪs ᴘᴀɢᴇs ʙᴜᴛᴛᴏɴ 😅")
        except Exception:
            pass

    elif query.data == "search_instructions":
        try:
            await query.answer()
        except Exception:
            pass
        txt = getattr(script, "SEARCH_INSTRUCTION_TXT", "Send movie or series name directly to search.")
        await client.send_message(
            chat_id=query.message.chat.id,
            text=txt,
            parse_mode=enums.ParseMode.HTML
        )

    elif query.data.startswith("file"):
        ident, file_id = query.data.split("#")
        user = query.message.reply_to_message.from_user.id if query.message.reply_to_message else query.from_user.id
        if int(user) != 0 and query.from_user.id != int(user):
            try:
                return await query.answer(script.ALRT_TXT.format(query.from_user.first_name), show_alert=True)
            except Exception:
                return
        try:
            await query.answer(url=f"https://t.me/{temp.U_NAME}?start=file_{query.message.chat.id}_{file_id}")
        except Exception:
            pass

    elif query.data.startswith("sendfiles"):
        ident, key = query.data.split("#")
        try:
            await query.answer(url=f"https://telegram.me/{temp.U_NAME}?start=allfiles_{query.message.chat.id}_{key}")
            return
        except (QueryIdInvalid, MessageIdInvalid):
            return
        except UserIsBlocked:
            try:
                await query.answer('Uɴʙʟᴏᴄᴋ ᴛʜᴇ ʙᴏᴛ ᴍᴀʜɴ !', show_alert=True)
            except Exception:
                pass
            return
        except PeerIdInvalid:
            try:
                await query.answer(url=f"https://telegram.me/{temp.U_NAME}?start=sendfiles3_{key}")
            except Exception:
                pass
            return
        except Exception as e:
            logger.warning("Error in sendfiles callback: %s", e)
            try:
                await query.answer(url=f"https://telegram.me/{temp.U_NAME}?start=sendfiles4_{key}")
            except Exception:
                pass
            return

