@Client.on_message(filters.group & filters.text & filters.incoming & ~filters.regex(r"^/"))
async def give_filter(client, message):
    if EMOJI_MODE:
        try:
            await message.react(emoji=random.choice(REACTIONS), big=True)
        except Exception:
            try:
                await message.react(emoji="⚡️")
            except Exception:
                pass
    try:
        await mdb.update_top_messages(message.from_user.id, message.text)
    except Exception:
        pass

    if message.chat.id != SUPPORT_CHAT_ID:
        settings = await get_settings(message.chat.id)
        try:
            if settings.get('auto_ffilter', True):
                if re.search(r'https?://\S+|www\.\S+|t\.me/\S+', message.text):
                    if await is_check_admin(client, message.chat.id, message.from_user.id):
                        return
                    return await message.delete()
                await auto_filter(client, message)
        except Exception as e:
            logger.exception("Error in auto filter: %s", e)
    else:
        search = message.text
        _, _, total_results = await get_search_results(chat_id=message.chat.id, query=search.lower(), offset=0, filter=True)
        if total_results == 0:
            return
        txt = getattr(script, "ALREADY_AVAILABLE_TXT", "<b>Hᴇʏ {}</b>,\n\n<code>{}</code> ɪꜱ ᴀʟʀᴇᴀᴅʏ ᴀᴠᴀɪʟᴀʙʟᴇ!")
        try:
            reply_text = txt.format(message.from_user.mention, total_results, search)
        except Exception:
            reply_text = f"<b>{search}</b> is available!"
        await message.reply_text(
            reply_text,
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🔍 ᴊᴏɪɴ ᴀɴᴅ ꜱᴇᴀʀᴄʜ ʜᴇʀᴇ 🔎", url=GRP_LNK)]])
        )


@Client.on_message(filters.private & filters.text & filters.incoming & ~filters.regex(r"^/") & ~filters.regex(r"(https?://)?(t\.me|telegram\.me|telegram\.dog)/"))
async def pm_text(bot, message):
    bot_id = bot.me.id if bot.me else (await bot.get_me()).id
    content = message.text
    user = message.from_user.first_name if message.from_user else "User"
    user_id = message.from_user.id if message.from_user else 0

    if EMOJI_MODE:
        try:
            await message.react(emoji=random.choice(REACTIONS), big=True)
        except Exception:
            try:
                await message.react(emoji="⚡️")
            except Exception:
                pass

    if content.startswith("#"):
        return

    try:
        await mdb.update_top_messages(user_id, content)
    except Exception:
        pass

    pm_search_enabled = True
    try:
        pm_search_enabled = await db.pm_search_status(bot_id)
    except Exception as e:
        logger.warning("pm_search_status check failed: %s", e)
        pm_search_enabled = PM_SEARCH

    if pm_search_enabled:
        await auto_filter(bot, message)
    else:
        disabled_text = getattr(
            script, 
            "PM_SEARCH_DISABLED_TXT", 
            "<b>Hᴇʏ {},\n\nPM Sᴇᴀʀᴄʜ ɪs Dɪsᴀʙʟᴇᴅ Bʏ Aᴅᴍɪɴ. Pʟᴇᴀsᴇ Sᴇᴀʀᴄʜ Iɴ Oᴜʀ Gʀᴏᴜᴘ !</b>"
        )
        try:
            reply_t = disabled_text.format(user)
        except Exception:
            reply_t = disabled_text

        try:
            await message.reply_text(
                text=reply_t,
                reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("📝 ʀᴇǫᴜᴇsᴛ ʜᴇʀᴇ ", url=GRP_LNK)]])
            )
            if LOG_CHANNEL:
                log_text = getattr(script, "PM_LOG_TXT", "User: {}\nID: {}\nQuery: {}")
                try:
                    formatted_log = log_text.format(user, user_id, content)
                except Exception:
                    formatted_log = f"User: {user} ({user_id})\nQuery: {content}"
                await bot.send_message(chat_id=LOG_CHANNEL, text=formatted_log)
        except Exception as e:
            logger.error("Failed to send PM search disabled alert: %s", e)


